# Prevent browsing directory indexes
Options -Indexes

# Only the submission endpoint is public. Helpers, dependencies and backups are private.
<FilesMatch "^(?!submit-enquiry\.php$).+">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:lib|PHPMailer|vendor)(?:/|$) - [F,L]
</IfModule>

# PHP also bounds the actual input stream. Server-level failures may be non-JSON;
# the frontend treats those as errors and retains the form.
LimitRequestBody 32768

# Allow preflight and HTTP headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
</IfModule>
